// Fantasy Copilot — Phase 1 schema.
//
// Datasource note: this schema runs unchanged on SQLite (local dev) and
// Postgres (deployments). JSON payloads — scoring settings, roster slots,
// platform IDs — are stored as TEXT and read through the typed helpers in
// src/lib/json.ts, because Prisma's SQLite connector has no native Json type.
// TEXT behaves identically on both, so no migration is needed to switch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Do not edit by hand — scripts/prisma-schema.mjs rewrites this into
  // prisma/generated-schema.prisma to match DATABASE_URL (sqlite locally,
  // postgresql when deployed). Run prisma via the npm db:* scripts.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id               String  @id @default(cuid())
  platform         String // "sleeper" | "espn" | "manual"
  platformLeagueId String
  sport            String  @default("football")
  season           String
  name             String
  teamCount        Int
  currentWeek      Int     @default(0)
  seasonState      String? // "pre_draft" | "drafting" | "in_season" | "complete"

  // JSON payloads (TEXT on SQLite, see note above)
  scoringSettingsJson String @default("{}")
  rosterSlotsJson     String @default("[]")

  waiverType   String? // "faab" | "rolling"
  waiverBudget Int?
  isDynasty    Boolean @default(false)
  isKeeper     Boolean @default(false)

  // Sync bookkeeping so the UI can show stale data honestly
  syncStatus    String    @default("never") // never | ok | stale | error
  lastSyncedAt  DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]

  @@unique([platform, platformLeagueId, season])
}

model Team {
  id             String @id @default(cuid())
  leagueId       String
  league         League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  platformTeamId String

  name      String
  ownerName String?
  avatar    String?

  wins          Int   @default(0)
  losses        Int   @default(0)
  ties          Int   @default(0)
  pointsFor     Float @default(0)
  pointsAgainst Float @default(0)

  waiverBudgetUsed Int?
  isMine           Boolean @default(false)

  rosterSpots RosterSpot[]

  @@unique([leagueId, platformTeamId])
}

model Player {
  id String @id @default(cuid())

  // Canonical cross-platform identity. sleeperId is unique when present so
  // repeat syncs update rather than duplicate.
  sleeperId       String? @unique
  /// nflverse/NFL GSIS id (e.g. 00-0036900). Sleeper's dictionary supplies it,
  /// which lets stats join on an id instead of fuzzy name matching.
  gsisId          String? @unique
  platformIdsJson String  @default("{}")

  fullName     String
  position     String?
  nflTeam      String?
  age          Int?
  yearsExp     Int?
  injuryStatus String?
  injuryNote   String?
  byeWeek      Int?

  updatedAt DateTime @updatedAt @default(now())

  rosterSpots RosterSpot[]
  weeklyStats WeeklyStat[]
  projections Projection[]

  @@index([position])
  @@index([fullName])
}

model WeeklyStat {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  season       String
  week         Int
  opponentTeam String?
  /// Full nflverse row, so new features can be used without a re-ingest.
  statLineJson String  @default("{}")

  // Denormalized opportunity features — what actually predicts fantasy output.
  targets         Int?
  targetShare     Float?
  airYardsShare   Float?
  wopr            Float?
  carries         Int?
  receptions      Int?
  fantasyPointsPpr Float?

  @@unique([playerId, season, week])
  @@index([season, week])
}

model Projection {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  leagueId String

  season          String
  week            Int
  projectedPoints Float
  floor           Float
  ceiling         Float
  /// 0..1 — sample size, role stability and injury certainty.
  confidence      Float
  modelVersion    String
  /// JSON array of short strings explaining the number.
  reasoningJson   String @default("[]")

  createdAt DateTime @default(now())

  @@unique([playerId, leagueId, season, week])
  @@index([leagueId, week])
}

model RosterSpot {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  slot        String // "QB" | "RB" | "FLEX" | "BN" | "IR" | "TAXI" ...
  slotIndex   Int? // position within the starting lineup, null for bench
  isStarter   Boolean @default(false)
  isProtected Boolean @default(false) // used by later phases; never auto-dropped

  @@unique([teamId, playerId])
  @@index([teamId])
}

// Simple key/value store: selected league, which team is mine, etc.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @default(now())
}

// Tracks the ~5MB Sleeper player dictionary so we fetch it at most once a day.
model PlayerCacheMeta {
  id          String   @id @default("sleeper-nfl")
  fetchedAt   DateTime
  playerCount Int      @default(0)
}

// ─── LLM layer ───────────────────────────────────────────────────────────────
// Providers are database rows, not code. Almost every provider speaks the
// OpenAI chat-completions wire format, so "openai-compatible" plus a baseUrl
// covers Groq, OpenRouter, Together, DeepSeek, Ollama, LM Studio and more.
// Only Anthropic needs its own request shape.

model LlmProvider {
  id            String  @id @default(cuid())
  label         String
  kind          String  @default("openai-compatible") // openai-compatible | anthropic
  baseUrl       String
  apiKey        String? // stored server-side, never returned to the browser
  modelId       String
  supportsTools Boolean @default(true)
  isDefault     Boolean @default(false)

  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastTestNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  leagueId  String?
  title     String    @default("New chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([leagueId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String // user | assistant | system
  content   String
  /// JSON array of {name, input, summary} describing tools used for this answer.
  toolsJson String   @default("[]")
  createdAt DateTime @default(now())

  @@index([conversationId])
}

// ─── Trades ──────────────────────────────────────────────────────────────────

model TradeBlock {
  id       String @id @default(cuid())
  leagueId String
  teamId   String
  playerId String

  /// "available" | "seeking" — a team can advertise both sides of a need.
  intent    String   @default("available")
  note      String?
  createdAt DateTime @default(now())

  @@unique([teamId, playerId, intent])
  @@index([leagueId])
}

// ─── MCP access ──────────────────────────────────────────────────────────────

model ApiKey {
  id     String @id @default(cuid())
  label  String
  /// SHA-256 of the key. The plaintext is shown once, at creation, and never stored.
  hash   String @unique
  prefix String
  /// JSON array: "read:league" | "read:projections" | "read:trades"
  scopesJson String @default("[\"read:league\"]")

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([prefix])
}

model ValueProviderConfig {
  id    String @id @default(cuid())
  label String
  /// built-in-vor | http | csv
  kind  String @default("built-in-vor")

  endpoint String?
  apiKey   String?
  /// For kind=csv: JSON array of {name, value}.
  rowsJson String?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}
