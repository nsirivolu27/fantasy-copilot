# ─── Database ────────────────────────────────────────────────────────────────
# SQLite for local dev — zero setup, no server to run.
DATABASE_URL="file:./dev.db"
#
# For any deployment use Postgres instead. The provider switches automatically
# based on this URL (see scripts/prisma-schema.mjs) — no schema edit needed.
# DATABASE_URL="postgresql://user:pass@host:5432/fantasy_copilot?sslmode=require"

# ─── Optional: lock a public deployment ──────────────────────────────────────
# Set this and every page requires a password (HTTP Basic; username ignored).
# Leave unset for localhost. This is a shared gate for you and your league,
# not real per-user auth.
# APP_PASSWORD="pick-something-long"

# Required on any public deployment: protects POST/GET /api/sync so a stranger
# can't trigger syncs. The scheduled job sends it as `Authorization: Bearer …`.
# SYNC_SECRET="generate-with-openssl-rand-hex-32"

# ─── Optional: offline demo mode ─────────────────────────────────────────────
# Serves fixtures/ instead of calling Sleeper. Use league ID 1124839284756483920.
# SLEEPER_FIXTURES="1"
